{
  "manifest_version": 3,
  "name": "Narro",
  "short_name": "Narro",
  "version": "1.3.1",
  "description": "Narro reads any webpage aloud using AI voices.",
  "homepage_url": "https://github.com/swrdfish/Narro",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "tts",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://api.openai.com/*",
    "https://api.elevenlabs.io/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Read this page with Narro",
    "default_popup": "options.html?popup"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "play-pause": {
      "description": "Play / pause reading"
    },
    "pick-start": {
      "description": "Choose where to start reading"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
