{
  "name": "narro",
  "version": "1.3.1",
  "description": "Chrome extension that reads web pages aloud with AI voices, in the cloud or entirely in your browser.",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "text-to-speech",
    "tts",
    "read-aloud",
    "kokoro",
    "piper",
    "accessibility"
  ],
  "homepage": "https://github.com/swrdfish/Narro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swrdfish/Narro.git"
  },
  "bugs": {
    "url": "https://github.com/swrdfish/Narro/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && cd dist && zip -r -FS ../narro-$npm_package_version.zip .",
    "version": "node scripts/sync-version.mjs && git add manifest.json",
    "watch": "node build.mjs --watch",
    "test": "node --test test/*.test.js",
    "site": "node scripts/build-site.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "video": "node scripts/build-video.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "kokoro-js": "^1.2.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^23.11.1"
  }
}
